build/
build-*/
build2/
*.pgm

# consumer-handoff/ holds A2GSPU-bound content extracted from RIPlib during
# the consumer-decoupling work (DLL RE notes, integration notes, audit trail).
# It is NOT part of the RIPlib library itself — it's a staging area for the
# downstream A2GSPU project to absorb, and is already excluded from the
# sync-to-a2gspu script. Kept on local disk, out of version control.
consumer-handoff/

# MSVC/GCC scratch output that lands in the repo root when a source file
# is compiled directly rather than through CMake.
*.pdb
*.su
*.obj

# scripts/dll-dispatch-table.py defaults its -o to a file in the working
# directory, so running it from the repo root -- which is how every example
# in the docs invokes it -- drops this here.  It is a dump of the driver's
# dispatch record, regenerated on demand from an image that is deliberately
# not vendored, so there is nothing to gain by tracking it.
dispatch-table.json
