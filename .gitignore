build/
build-*/
build2/
*.pgm

# consumer-handoff/ holds A2GSPU-bound content extracted from RIPlib during
# the consumer-decoupling work (DLL RE notes, integration notes, audit trail).
# It is NOT part of the RIPlib library itself — it's a staging area for the
# downstream A2GSPU project to absorb, and is already excluded from the
# sync-to-a2gspu script. Kept on local disk, out of version control.
consumer-handoff/

# MSVC/GCC scratch output that lands in the repo root when a source file
# is compiled directly rather than through CMake.
*.pdb
*.su
*.obj

# scripts/dll-dispatch-table.py defaults its -o to a file in the working
# directory, so running it from the repo root -- which is how every example
# in the docs invokes it -- drops this here.  It is a dump of the driver's
# dispatch record, regenerated on demand from an image that is deliberately
# not vendored, so there is nothing to gain by tracking it.
dispatch-table.json

# Claude Code local settings — machine-specific permissions and paths.
# The shared project commands in .claude/commands/ ARE tracked.
.claude/settings.local.json

# scripts/ci-local.sh working files
analyzer-local.log
.ci-local-probe/

# Internal working record -- kept on local disk, out of version control.
# These are the session-by-session ledgers the project is steered with:
# candidate/decision traces, the uncertainty register, and the alignment
# phase plan.  They are working notes, not deliverables, and they carry
# incidental local machine layout.  The ADRs in design/adr/ and
# design/syntax-audit.md ARE published -- they are the reasoning a
# consumer or a reviewer needs, and public docs cite them as evidence.
design/decisions.md
design/knowledge.md
design/bbs-land-alignment.md

# Assistant tooling for working on this repo, not part of the library.
.claude/
